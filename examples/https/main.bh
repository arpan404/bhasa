import "@tls"

# Arguments: certificate-chain.pem private-key.pem [port=8443] [requests=0].
# One request per connection. Supply your own certificate and unencrypted key.
def main() -> int {
    if arg_count() < 3 { return 2 }
    var port = 8443
    var requests = 0
    if arg_count() > 3 { port = http_length(arg(3)) }
    if arg_count() > 4 { requests = http_length(arg(4)) }
    if port < 0 or port > 65535 or requests < 0 { return 2 }
    var listener = tcp_listen_on("127.0.0.1", port)
    if tcp_listener_status(listener) != 0 { return 1 }
    var announcement = to_buffer(tcp_local_port(listener))
    append(announcement, "\n")
    var output_status = write_stdout(announcement)
    if output_status != 0 { return 1 }
    var served = 0
    while requests == 0 or served < requests {
        # Includes accept + handshake under a deadline; bad clients are isolated.
        var socket = tls_accept(listener, arg(1), arg(2), 5000)
        if tls_status(socket) == 0 {
            var status = 200
            var body = text("{\"ok\":true}")
            match https_read(socket, 2000) {
                case HttpResult.error(message) {
                    status = 400
                    body = text("{\"error\":\"invalid request\"}")
                }
                case HttpResult.ok(request) {
                    if !same(request.method.bytes, "GET") or !same(request.path.bytes, "/health") {
                        status = 404
                        body = text("{\"error\":\"not found\"}")
                    }
                }
            }
            match https_write(socket, status, body, 2000) {
                case ResultInt.ok(bytes) { var closed = tls_shutdown(socket, 2000) }
                case ResultInt.error(message) { print(message.bytes) }
            }
        }
        served = served + 1
    }
    return 0
}
