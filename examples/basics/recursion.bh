# Calls may refer to a function declared later.
def main() {
    print(factorial(10))
    print(fibonacci(10))
}

def factorial(n: int) -> int {
    if n <= 1 {
        return 1
    } else {
        return n * factorial(n - 1)
    }
}

def fibonacci(n: int) -> int {
    if n < 2 {
        return n
    } else {
        return fibonacci(n - 1) + fibonacci(n - 2)
    }
}
