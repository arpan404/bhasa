struct Counter {
    value: int
}

def main() {
    let greeting = buffer("hello")
    append(greeting, " world")
    print(greeting)

    let counter = Counter(1)
    counter.value = counter.value + 1
    print(counter.value)

    var total = 0
    for number in range(1, 4) {
        let doubled = number * 2
        total = total + doubled
    }
    print(total)
}
