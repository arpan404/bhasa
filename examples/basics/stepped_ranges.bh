def main() {
    var total = 0
    for number in range(1, 8, 3) { total = total + number }
    print(total)

    var descending = 0
    for number in range(6, 0, -2) {
        if number == 4 { continue }
        descending = descending + number
    }
    print(descending)

    var crossings = 0
    for number in range(0x7ffffffffffffffe, 0x7fffffffffffffff, 2) {
        crossings = crossings + 1
    }
    for number in range(-0x7fffffffffffffff, -0x8000000000000000, -2) {
        crossings = crossings + 1
    }
    print(crossings)
}
