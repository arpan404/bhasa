def main() {
    print(2 + 3 * 4)
    print((2 + 3) * 4)
    print(20 - 5 - 3)
    print(100 / 5 / 2)
    print(-7 / 3)
    print(-7 % 3)
    print(7 % -3)
    print(9223372036854775807)
    print(-9223372036854775807 - 1)
    print(1 < 2)
    print(2 <= 2)
    print(3 > 2)
    print(3 >= 3)
    print(4 == 4)
    print(4 != 5)
    print(true == false)
    print(true != false)
    print(not false and !false)
}
