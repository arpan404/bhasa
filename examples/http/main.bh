import "@std"

# localhost server: GET /health, GET /counter, POST /echo.
# Arguments: port (default 8080), request count (0 means keep serving).
def serve_request(socket: tcp_socket, counters: StringIntMap) -> int {
    var status = 200
    var body = text("{\"ok\":true}")
    match http_read(socket, 2000) {
        case HttpResult.error(message) {
            status = 400
            body = text("{\"error\":\"invalid request\"}")
        }
        case HttpResult.ok(request) {
            if same(request.method.bytes(), "GET") and same(request.path.bytes(), "/health") {
                body = text("{\"ok\":true}")
            } else {
                if same(request.method.bytes(), "GET") and same(request.path.bytes(), "/counter") {
                    var count = 0
                    match counters.get(text("requests")) {
                        case OptionInt.none { count = 0 }
                        case OptionInt.some(value) { count = value }
                    }
                    count = count + 1
                    counters.put(text("requests"), count)
                    var bytes = buffer("{\"count\":")
                    append(bytes, to_buffer(count)); append(bytes, "}")
                    body = text_from_bytes(bytes)
                } else {
                    if same(request.method.bytes(), "POST") and same(request.path.bytes(), "/echo") {
                        match json_parse(request.body) {
                            case JsonResult.error(message) {
                                status = 400
                                body = text("{\"error\":\"invalid JSON\"}")
                            }
                            case JsonResult.ok(document) { body = text_from_bytes(document.raw(0)) }
                        }
                    } else {
                        status = 404
                        body = text("{\"error\":\"not found\"}")
                    }
                }
            }
        }
    }
    match http_write(socket, status, body, 2000) {
        case ResultInt.ok(bytes) { return 0 }
        case ResultInt.error(message) { return 1 }
    }
}

def main() -> int {
    var port = 8080
    var requests = 0
    if arg_count() > 1 { port = http_length(arg(1)) }
    if arg_count() > 2 { requests = http_length(arg(2)) }
    if port < 0 or port > 65535 or requests < 0 { return 1 }
    var listener = tcp_listen_on("127.0.0.1", port)
    if tcp_listener_status(listener) != 0 { return 1 }
    var announcement = to_buffer(tcp_local_port(listener))
    append(announcement, "\n")
    var output_status = write_stdout(announcement)
    if output_status != 0 { return 1 }
    var counters = string_int_map()
    var served = 0
    while requests == 0 or served < requests {
        var socket = tcp_accept(listener)
        if tcp_socket_status(socket) != 0 { return 1 }
        var result = serve_request(socket, counters)
        # Client errors end that request; the listener continues serving.
        served = served + 1
    }
    return 0
}
