def be_collection_helper(ctx: ints, definitions: buffer, node: int) {
    var ty = node + 100; var kind_code = be_collection_kind(ctx, ty)
    var kind = buffer("list")
    if kind_code == 2 { kind = buffer("map") }
    var name = be_number("@bhasa.record.", ty)
    var callbacks = be_number("@bhasa.collection.", ty)
