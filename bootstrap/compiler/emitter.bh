    append(definitions, kind); append(definitions, "_new("); append(definitions, constructor); append(definitions, ")\n  ret ptr %result\n}\n\n")
    append(definitions, "define internal ptr "); append(definitions, name); append(definitions, ".clone(ptr %source) {\nentry:\n  %result = call ptr @bhasa_rt_")
    append(definitions, kind); append(definitions, "_clone(ptr %source)\n  ret ptr %result\n}\n\n")
    append(definitions, "define internal void "); append(definitions, name); append(definitions, ".free(ptr %source) {\nentry:\n  call void @bhasa_rt_")
    append(definitions, kind); append(definitions, "_free(ptr %source)\n  ret void\n}\n\n")
    be_collection_method(definitions, ty, kind, buffer("count"), ints(), 1)
    be_collection_method(definitions, ty, kind, buffer("clear"), ints(), 0)
