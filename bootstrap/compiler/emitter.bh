    var condition_label = be_label(ctx); var loop_label = be_label(ctx); var exit_label = be_label(ctx)
    be_jump(body, ctx, condition_label); be_start(body, ctx, condition_label)
    var condition = be_expression(source, tokens, ctx, errors, globals, allocations, body, 1)
    if get(ctx, 14) != 2 { be_error(tokens, ctx, errors, 201) }
    be_branch(body, ctx, condition, loop_label, exit_label)
    be_start(body, ctx, loop_label)
    var loop = be_loop_push(ctx, exit_label, condition_label, get(ctx, 7))
    be_block(source, tokens, ctx, errors, globals, allocations, body, true)
