# Zero is unseen, -1 is active, and a positive state is the completed height.
# Explicit DFS frames keep hostile record chains off the compiler call stack.
def be_record_layouts(tokens: ints, ctx: ints, errors: ints) {
    var states = ints()
    var i = 0
    while i < len(ctx) { push(states, 0); i = i + 1 }
    var frames = ints()
    i = 0
    while i < 384 { push(frames, 0); i = i + 1 }
    var root = get(ctx, 19)
    while root >= 0 and len(errors) == 0 {
        if get(states, root) == 0 {
            set(frames, 0, root); set(frames, 1, 0); set(frames, 2, 0)
            set(states, root, -1)
            var depth = 1
            while depth > 0 and len(errors) == 0 {
                var frame = (depth - 1) * 3
                var node = get(frames, frame)
                var field = get(frames, frame + 1)
                if field == get(ctx, node + 2) {
                    var height = get(frames, frame + 2) + 1
                    if height > 128 { be_error_at(tokens, errors, 213, get(ctx, node + 1)); return }
                    set(states, node, height)
                    depth = depth - 1
                    if depth > 0 {
                        var parent = (depth - 1) * 3 + 2
                        if get(frames, parent) < height { set(frames, parent, height) }
                    }
                } else {
                    set(frames, frame + 1, field + 1)
                    var ty = get(ctx, node + 6 + field * 3)
                    if ty >= 100 {
                        var child = be_record_node(ty)
                        var state = get(states, child)
                        if state < 0 { be_error_at(tokens, errors, 213, get(ctx, node + 5 + field * 3)); return }
                        if state > 0 {
                            if get(frames, frame + 2) < state { set(frames, frame + 2, state) }
                        } else {
                            if depth >= 128 { be_error_at(tokens, errors, 213, get(ctx, child + 1)); return }
                            set(frames, depth * 3, child); set(frames, depth * 3 + 1, 0); set(frames, depth * 3 + 2, 0)
                            set(states, child, -1)
                            depth = depth + 1
                        }
                    }
                }
            }
        }
        root = get(ctx, root)
    }
}
def be_records(source: buffer, tokens: ints, ctx: ints, errors: ints) {
    set(ctx, 0, 0)
    be_record_names(source, tokens, ctx, errors)
    var node = get(ctx, 19)
    while node >= 0 and len(errors) == 0 {
        var info = be_enum_info(ctx, node + 100)
        if info >= 0 { be_enum_fields(source, tokens, ctx, errors, node, info) } else { be_record_fields(source, tokens, ctx, errors, node) }
        if len(errors) == 0 { be_collection_register(source, tokens, ctx, errors, node) }
        node = get(ctx, node)
    }
    if len(errors) == 0 { be_record_layouts(tokens, ctx, errors) }
    set(ctx, 0, 0)
}
# Intrinsic collections retain nominal record types but store no source-visible fields.
# Registry entries are next, record type, kind (1=list, 2=map).
def be_collection_kind(ctx: ints, ty: int) -> int {
    var node = get(ctx, 28)
    while node >= 0 {
        if get(ctx, node + 1) == ty { return get(ctx, node + 2) }
        node = get(ctx, node)
    }
    return 0
}
def be_collection_register(source: buffer, tokens: ints, ctx: ints, errors: ints, record: int) {
    var name = bh_token_text(source, tokens, get(ctx, record + 1))
    var kind = 0; var prefix = 0
    if len(name) >= 11 { if same(slice(name, 0, 11), "__bhg_list_") { kind = 1; prefix = 11 } }
    if len(name) >= 10 { if same(slice(name, 0, 10), "__bhg_map_") { kind = 2; prefix = 10 } }
    if kind == 0 { return }
    var valid = len(name) > prefix and get(ctx, record + 2) == kind and be_enum_info(ctx, record + 100) < 0
    var i = prefix
    while i < len(name) {
        if get(name, i) < 48 or get(name, i) > 57 { valid = false }
        i = i + 1
    }
    if valid {
        var field = bh_token_text(source, tokens, get(ctx, record + 5))
        if kind == 1 { valid = same(field, "__element") } else {
            valid = same(field, "__key") and same(bh_token_text(source, tokens, get(ctx, record + 8)), "__value")
            var key = get(ctx, record + 6)
            if key != 1 and key != 3 { valid = false }
        }
    }
    var method = get(ctx, 24)
    while method >= 0 {
        if get(ctx, method + 7) == record + 100 { valid = false }
        method = get(ctx, method)
    }
    if not valid { be_error_at(tokens, errors, 213, get(ctx, record + 1)); return }
    var node = len(ctx)
    push(ctx, get(ctx, 28)); push(ctx, record + 100); push(ctx, kind); set(ctx, 28, node)
}
def be_collection_signature(source: buffer, tokens: ints, ctx: ints, ty: int, name_token: int) -> int {
    var kind = be_collection_kind(ctx, ty)
    if kind == 0 { return -1 }
    var name = bh_token_text(source, tokens, name_token)
    var params = ints(); push(params, ty)
    var result = 0
    var element = get(ctx, ty - 100 + 6)
    if same(name, "count") { result = 1 } else {
    if same(name, "clear") { result = 0 } else {
    if kind == 1 {
        if same(name, "get") { push(params, 1); result = element } else {
        if same(name, "push") { push(params, element) } else {
        if same(name, "set") { push(params, 1); push(params, element) } else { return -1 }
        }
        }
    } else {
        var value = get(ctx, ty - 100 + 9)
        push(params, element)
        if same(name, "get") { result = value } else {
        if same(name, "put") { push(params, value) } else {
        if same(name, "contains") or same(name, "remove") { result = 2 } else { return -1 }
        }
        }
    }
    }
    }
    # This signature has no source body and is not linked into the method list.
    var node = len(ctx)
    push(ctx, -1); push(ctx, name_token); push(ctx, result); push(ctx, len(params))
    push(ctx, 0); push(ctx, 0); push(ctx, 0); push(ctx, ty)
    var i = 0
    while i < len(params) { push(ctx, name_token); push(ctx, get(params, i)); i = i + 1 }
    return node
}
def be_collection_callback(ctx: ints, definitions: buffer, name: buffer, ty: int) {
    var llvm = be_llvm_type(ty)
    append(definitions, "define internal void "); append(definitions, name)
    append(definitions, ".clone(ptr %dst, ptr %src) {\nentry:\n  %value = load "); append(definitions, llvm); append(definitions, ", ptr %src\n")
    var value = buffer("%value")
    if be_owned(ty) {
        append(definitions, "  %copy = call ptr @"); append(definitions, be_owned_symbol(ty, true)); append(definitions, "(ptr %value)\n")
        value = buffer("%copy")
    }
    append(definitions, "  store "); append(definitions, llvm); append(definitions, " "); append(definitions, value)
    append(definitions, ", ptr %dst\n  ret void\n}\n\n")
    append(definitions, "define internal void "); append(definitions, name); append(definitions, ".drop(ptr %slot) {\nentry:\n")
    if be_owned(ty) {
        append(definitions, "  %value = load ptr, ptr %slot\n  call void @"); append(definitions, be_owned_symbol(ty, false)); append(definitions, "(ptr %value)\n")
    }
    append(definitions, "  ret void\n}\n\n")
}
def be_collection_method(definitions: buffer, ty: int, kind: buffer, method: buffer, params: ints, result: int) {
    append(definitions, "define internal "); append(definitions, be_llvm_type(result)); append(definitions, " @bhasa.method."); append(definitions, to_buffer(ty)); append(definitions, "."); append(definitions, method)
    append(definitions, "(ptr %self")
    var i = 0
    while i < len(params) {
        append(definitions, ", "); append(definitions, be_llvm_type(get(params, i))); append(definitions, " %arg."); append(definitions, to_buffer(i))
        i = i + 1
    }
    append(definitions, ") {\nentry:\n")
    var arguments = buffer("ptr %self")
    i = 0
    while i < len(params) {
        var index = to_buffer(i); var llvm = be_llvm_type(get(params, i))
        if same(kind, "list") and i == 0 and (same(method, "get") or same(method, "set")) {
            append(arguments, ", i64 %arg."); append(arguments, index)
        } else {
            append(definitions, "  %slot."); append(definitions, index); append(definitions, " = alloca "); append(definitions, llvm)
            append(definitions, "\n  store "); append(definitions, llvm); append(definitions, " %arg."); append(definitions, index)
            append(definitions, ", ptr %slot."); append(definitions, index); append(definitions, "\n")
            append(arguments, ", ptr %slot."); append(arguments, index)
        }
        i = i + 1
    }
    var llvm = be_llvm_type(result)
    if same(method, "get") {
        append(definitions, "  %out = alloca "); append(definitions, llvm); append(definitions, "\n  call void @bhasa_rt_")
        append(definitions, kind); append(definitions, "_get("); append(definitions, arguments); append(definitions, ", ptr %out)\n  %result = load ")
        append(definitions, llvm); append(definitions, ", ptr %out\n  ret "); append(definitions, llvm); append(definitions, " %result\n")
    } else {
        if result == 0 { append(definitions, "  call void @bhasa_rt_") } else { append(definitions, "  %result = call i64 @bhasa_rt_") }
        append(definitions, kind); append(definitions, "_"); append(definitions, method); append(definitions, "("); append(definitions, arguments); append(definitions, ")\n")
        if result == 0 { append(definitions, "  ret void\n") } else {
            if result == 2 { append(definitions, "  %boolean = icmp ne i64 %result, 0\n  ret i1 %boolean\n") } else { append(definitions, "  ret i64 %result\n") }
