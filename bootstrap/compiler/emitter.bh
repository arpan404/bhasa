def be_function(source: buffer, tokens: ints, ctx: ints, errors: ints, globals: buffer, definitions: buffer, node: int) {
    set(ctx, 0, get(ctx, node + 4)); set(ctx, 1, 0); set(ctx, 2, 1); set(ctx, 3, 0)
    set(ctx, 4, 0); set(ctx, 5, get(ctx, node + 2)); set(ctx, 7, -1); set(ctx, 8, 0); set(ctx, 9, 0); set(ctx, 12, node); set(ctx, 29, -1)
