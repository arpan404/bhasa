        append(definitions, "1")
    } else {
        append(definitions, "ptrtoint (ptr getelementptr ("); append(definitions, record)
        append(definitions, ", ptr null, i32 1) to "); append(definitions, size_type); append(definitions, ")")
    }
    append(definitions, ")\n  %failed = icmp eq ptr %record, null\n  br i1 %failed, label %failure, label %success\nfailure:\n  call void @llvm.trap()\n  unreachable\nsuccess:\n  ret ptr %record\n}\n\n")
    var enum_info = be_enum_info(ctx, node + 100)
    if enum_info >= 0 { be_enum_helpers(ctx, definitions, node, enum_info); return }
    append(definitions, "define internal ptr "); append(definitions, name)
    append(definitions, ".clone(ptr %source) {\nentry:\n  %record = call ptr "); append(definitions, name); append(definitions, ".new()\n")
    var i = 0
    while i < get(ctx, node + 2) {
        var ty = get(ctx, node + 6 + i * 3)
        var index = to_buffer(i)
        var llvm = be_llvm_type(ty)
        append(definitions, "  %source."); append(definitions, index); append(definitions, " = getelementptr "); append(definitions, record)
        append(definitions, ", ptr %source, i32 0, i32 "); append(definitions, index); append(definitions, "\n  %value."); append(definitions, index)
        append(definitions, " = load "); append(definitions, llvm); append(definitions, ", ptr %source."); append(definitions, index); append(definitions, "\n")
        var value = be_number("%value.", i)
        if be_owned(ty) {
            value = be_number("%copy.", i)
            append(definitions, "  "); append(definitions, value); append(definitions, " = call ptr @"); append(definitions, be_owned_symbol(ty, true))
            append(definitions, "(ptr %value."); append(definitions, index); append(definitions, ")\n")
        }
        append(definitions, "  %target."); append(definitions, index); append(definitions, " = getelementptr "); append(definitions, record)
        append(definitions, ", ptr %record, i32 0, i32 "); append(definitions, index); append(definitions, "\n  store ")
        append(definitions, llvm); append(definitions, " "); append(definitions, value); append(definitions, ", ptr %target."); append(definitions, index); append(definitions, "\n")
        i = i + 1
    }
    append(definitions, "  ret ptr %record\n}\n\n")
    append(definitions, "define internal void "); append(definitions, name); append(definitions, ".free(ptr %record) {\nentry:\n")
