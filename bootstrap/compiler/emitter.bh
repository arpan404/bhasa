# Record registry nodes use next, name-token, field-count, body-start, body-end,
# followed by name-token, type, index triples. Record types are node + 100.
def be_record_node(ty: int) -> int { return ty - 100 }
def be_record_find(source: buffer, tokens: ints, ctx: ints, name: int) -> int {
    return be_find(source, tokens, ctx, get(ctx, 19), name)
}
def be_record_field(source: buffer, tokens: ints, ctx: ints, ty: int, name: int) -> int {
    if ty < 100 or be_enum_info(ctx, ty) >= 0 or be_collection_kind(ctx, ty) != 0 { return -1 }
    var node = be_record_node(ty)
    var index = 0
    while index < get(ctx, node + 2) {
        var field = node + 5 + index * 3
        if be_same_name(source, tokens, get(ctx, field), name) { return field }
        index = index + 1
    }
    return -1
}
def be_record_skip_block(tokens: ints, ctx: ints, errors: ints) -> int {
    be_expect(tokens, ctx, errors, 123)
    var depth = 1
    var fields = 0
    var method_header = false
    var match_depths = ints(); var match_count = 0; var match_header = false
    while depth > 0 and len(errors) == 0 {
        var kind = be_kind(tokens, ctx)
        if kind == 0 or kind == 314 { be_error(tokens, ctx, errors, 200); return 0 }
        if kind == 300 and depth == 1 { method_header = true }
        if kind == 58 and depth == 1 and not method_header { fields = fields + 1 }
        if kind == 316 { match_header = true }
        if kind == 123 {
            depth = depth + 1
            if match_header {
                if match_count == len(match_depths) { push(match_depths, depth) } else { set(match_depths, match_count, depth) }
                match_count = match_count + 1; match_header = false
            }
        }
        if kind == 125 {
            if match_count > 0 and get(match_depths, match_count - 1) == depth { match_count = match_count - 1 }
            depth = depth - 1; if depth == 1 { method_header = false }
        }
        # Outer function and record wrappers are outside the body depth budget.
        var limit = 129
        if method_header { limit = 130 }
        if depth - match_count > limit { be_error(tokens, ctx, errors, 204); return 0 }
        be_next(ctx)
    }
    return fields
}
# The schema pass must validate extern syntax before moving to another file.
# Resolve named types later, after every record name has been registered.
def be_skip_header_type(tokens: ints, ctx: ints, errors: ints) {
    var kind = be_kind(tokens, ctx)
    if kind == 1 or kind == 309 or kind == 310 or kind == 311 or kind == 312 or kind == 318 { be_next(ctx) } else { be_error(tokens, ctx, errors, 200) }
}
def be_skip_external_header(tokens: ints, ctx: ints, errors: ints) {
    be_expect(tokens, ctx, errors, 40)
    while be_kind(tokens, ctx) != 41 and len(errors) == 0 {
        be_expect(tokens, ctx, errors, 1)
        be_expect(tokens, ctx, errors, 58)
        be_skip_header_type(tokens, ctx, errors)
        if be_kind(tokens, ctx) == 44 { be_next(ctx) } else {
            if be_kind(tokens, ctx) != 41 { be_error(tokens, ctx, errors, 200) }
        }
    }
    be_expect(tokens, ctx, errors, 41)
    if be_kind(tokens, ctx) == 262 { be_next(ctx); be_skip_header_type(tokens, ctx, errors) }
    var kind = be_kind(tokens, ctx)
    if kind != 10 and kind != 59 and kind != 0 and kind != 314 { be_error(tokens, ctx, errors, 200) }
}
def be_record_names(source: buffer, tokens: ints, ctx: ints, errors: ints) {
    be_top_skip(tokens, ctx)
    while be_kind(tokens, ctx) != 0 and len(errors) == 0 {
        if be_kind(tokens, ctx) == 313 or be_kind(tokens, ctx) == 315 {
            var enumeration = be_kind(tokens, ctx) == 315
            be_next(ctx)
            var name = get(ctx, 0)
            be_expect(tokens, ctx, errors, 1)
            if len(errors) != 0 { return }
            var word = bh_token_text(source, tokens, name)
            if be_reserved(word) or same(word, "task") or same(word, "tcp_listener") or same(word, "tcp_socket") or same(word, "tls_socket") or be_record_find(source, tokens, ctx, name) >= 0 {
                be_error_at(tokens, errors, 212, name); return
            }
            be_newlines(tokens, ctx)
            var start = get(ctx, 0)
            var count = be_record_skip_block(tokens, ctx, errors)
            if enumeration { count = count + 1 }
            if len(errors) != 0 { return }
            var node = len(ctx)
            push(ctx, get(ctx, 19)); push(ctx, name); push(ctx, count)
            push(ctx, start); push(ctx, get(ctx, 0))
            var i = 0
            while i < count { push(ctx, 0); push(ctx, 0); push(ctx, i); i = i + 1 }
            set(ctx, 19, node)
            if enumeration {
                var info = len(ctx)
                push(ctx, get(ctx, 27)); push(ctx, node); push(ctx, -1); push(ctx, 0)
                set(ctx, 27, info)
            }
        } else {
            var external = false
            if be_kind(tokens, ctx) == 301 { external = true; be_next(ctx) }
            be_expect(tokens, ctx, errors, 300)
            be_expect(tokens, ctx, errors, 1)
            if len(errors) != 0 { return }
            if external { be_skip_external_header(tokens, ctx, errors) } else {
                var searching = true
                while searching and len(errors) == 0 {
                    var kind = be_kind(tokens, ctx)
                    if kind == 123 {
                        var ignored = be_record_skip_block(tokens, ctx, errors)
                        searching = false
                    } else {
                        if kind == 0 or kind == 314 { be_error(tokens, ctx, errors, 200); return }
                        be_next(ctx)
                    }
                }
            }
        }
        be_top_skip(tokens, ctx)
    }
}
def be_record_separators(tokens: ints, ctx: ints) {
    while be_kind(tokens, ctx) == 10 or be_kind(tokens, ctx) == 59 or be_kind(tokens, ctx) == 44 { be_next(ctx) }
}
def be_record_fields(source: buffer, tokens: ints, ctx: ints, errors: ints, node: int) {
    set(ctx, 0, get(ctx, node + 3))
    be_expect(tokens, ctx, errors, 123)
    be_record_separators(tokens, ctx)
    var count = 0
    while be_kind(tokens, ctx) != 125 and len(errors) == 0 {
        if be_kind(tokens, ctx) == 300 { be_declare_function(source, tokens, ctx, errors, node + 100) } else {
        var name = get(ctx, 0)
        be_expect(tokens, ctx, errors, 1)
        be_expect(tokens, ctx, errors, 58)
        if len(errors) != 0 { return }
        var ty = be_type(source, tokens, ctx, errors)
        if len(errors) != 0 { return }
        if ty == 0 or ty == 6 { be_error_at(tokens, errors, 201, name); return }
        if count >= get(ctx, node + 2) { be_error_at(tokens, errors, 200, name); return }
        var i = 0
        while i < count {
            if be_same_name(source, tokens, get(ctx, node + 5 + i * 3), name) { be_error_at(tokens, errors, 212, name); return }
            i = i + 1
        }
        set(ctx, node + 5 + count * 3, name)
        set(ctx, node + 6 + count * 3, ty)
        count = count + 1
        var kind = be_kind(tokens, ctx)
        if kind != 125 and kind != 10 and kind != 59 and kind != 44 { be_error(tokens, ctx, errors, 200); return }
        }
        be_record_separators(tokens, ctx)
    }
    be_expect(tokens, ctx, errors, 125)
    if count != get(ctx, node + 2) { be_error(tokens, ctx, errors, 200) }
    var method = get(ctx, 24)
    while method >= 0 and len(errors) == 0 {
        if get(ctx, method + 7) == node + 100 {
            if be_record_field(source, tokens, ctx, node + 100, get(ctx, method + 1)) >= 0 { be_error_at(tokens, errors, 212, get(ctx, method + 1)) }
        }
        method = get(ctx, method)
