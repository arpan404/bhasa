    append(declarations, "declare i64 @bhasa_rt_utf8_valid(ptr)\ndeclare i64 @bhasa_rt_utf8_count(ptr)\ndeclare i64 @bhasa_rt_utf8_get(ptr, i64)\ndeclare ptr @bhasa_rt_utf8_slice(ptr, i64, i64)\ndeclare i64 @bhasa_rt_utf8_append(ptr, i64)\ndeclare ptr @bhasa_rt_tcp_accept_timeout(ptr, i64)\ndeclare ptr @bhasa_rt_tcp_connect_timeout(ptr, i64, i64)\ndeclare ptr @bhasa_rt_tcp_connect_timeout_str(ptr, i64, i64)\ndeclare i64 @bhasa_rt_tcp_read_timeout(ptr, ptr, i64, i64)\ndeclare i64 @bhasa_rt_tcp_write_timeout(ptr, ptr, i64)\ndeclare i64 @bhasa_rt_monotonic_millis()\n")
    append(declarations, "declare ptr @bhasa_rt_async_spawn_i64(ptr, i64)\ndeclare i64 @bhasa_rt_await_i64(ptr)\ndeclare ptr @bhasa_rt_tls_connect(ptr, i64, ptr, ptr, i64)\ndeclare ptr @bhasa_rt_tls_accept(ptr, ptr, ptr, i64)\ndeclare i64 @bhasa_rt_tls_status(ptr)\ndeclare i64 @bhasa_rt_tls_read(ptr, ptr, i64, i64)\ndeclare i64 @bhasa_rt_tls_write(ptr, ptr, i64)\ndeclare i64 @bhasa_rt_tls_shutdown(ptr, i64)\ndeclare ptr @bhasa_rt_tls_socket_clone(ptr)\ndeclare void @bhasa_rt_tls_socket_free(ptr)\n")
    append(declarations, "declare ptr @bhasa_rt_list_new(i64, ptr, ptr)\ndeclare ptr @bhasa_rt_map_new(i64, i64, ptr, ptr, ptr, ptr, ptr, ptr)\ndeclare void @bhasa_rt_list_get(ptr, i64, ptr)\ndeclare void @bhasa_rt_list_push(ptr, ptr)\ndeclare void @bhasa_rt_list_set(ptr, i64, ptr)\ndeclare void @bhasa_rt_map_get(ptr, ptr, ptr)\ndeclare void @bhasa_rt_map_put(ptr, ptr, ptr)\ndeclare i64 @bhasa_rt_map_contains(ptr, ptr)\ndeclare i64 @bhasa_rt_map_remove(ptr, ptr)\ndeclare ptr @bhasa_rt_list_clone(ptr)\ndeclare void @bhasa_rt_list_free(ptr)\ndeclare i64 @bhasa_rt_list_count(ptr)\ndeclare void @bhasa_rt_list_clear(ptr)\ndeclare ptr @bhasa_rt_map_clone(ptr)\ndeclare void @bhasa_rt_map_free(ptr)\ndeclare i64 @bhasa_rt_map_count(ptr)\ndeclare void @bhasa_rt_map_clear(ptr)\ndeclare i64 @bhasa_rt_map_hash_i64(ptr)\ndeclare i64 @bhasa_rt_map_equal_i64(ptr, ptr)\ndeclare i64 @bhasa_rt_map_hash_str(ptr)\ndeclare i64 @bhasa_rt_map_equal_str(ptr, ptr)\n")
    append(declarations, "declare ptr @bhasa_rt_spawn_owned(ptr, ptr)\ndeclare ptr @bhasa_rt_async_spawn_owned(ptr, ptr)\ndeclare ptr @bhasa_rt_join_owned(ptr)\ndeclare ptr @bhasa_rt_await_owned(ptr)\ndeclare ptr @bhasa_rt_task_alloc(i64)\ndeclare void @bhasa_rt_task_free(ptr)\n")
