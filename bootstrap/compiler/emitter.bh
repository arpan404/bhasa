def be_external(source: buffer, tokens: ints, ctx: ints, definitions: buffer, node: int) {
    append(definitions, "declare "); append(definitions, be_llvm_type(get(ctx, node + 2)))
    append(definitions, " @"); append(definitions, bh_token_text(source, tokens, get(ctx, node + 1))); append(definitions, "(")
    var i = 0
    while i < get(ctx, node + 3) {
