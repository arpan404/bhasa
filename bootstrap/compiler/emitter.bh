def be_statement(source: buffer, tokens: ints, ctx: ints, errors: ints, globals: buffer, allocations: buffer, body: buffer) {
    var kind = be_kind(tokens, ctx)
    if kind == 319 { be_for(source, tokens, ctx, errors, globals, allocations, body); return }
    if kind == 321 or kind == 322 { be_loop_exit(tokens, ctx, errors, body, kind == 321); return }
    if kind == 316 { be_match(source, tokens, ctx, errors, globals, allocations, body); return }
    if kind == 302 {
