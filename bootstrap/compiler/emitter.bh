}

def be_record_helper(ctx: ints, definitions: buffer, node: int, size_type: buffer) {
    if be_collection_kind(ctx, node + 100) != 0 { be_collection_helper(ctx, definitions, node); return }
    var record = be_number("%bhasa.record.", node + 100)
    var name = be_number("@bhasa.record.", node + 100)
