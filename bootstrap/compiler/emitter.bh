    if kind == 4 { return be_float_literal(source, tokens, ctx, errors) }
    if kind == 3 {
        var text = bh_string_value(source, tokens, get(ctx, 0))
        be_next(ctx); be_meta(ctx, 3, 0)
        return be_string(globals, ctx, text)
    }
    if kind == 307 or kind == 308 {
        be_next(ctx); be_meta(ctx, 2, 0)
        if kind == 307 { return buffer("true") }
        return buffer("false")
    }
    if kind == 40 {
        be_next(ctx)
        var result = be_expression(source, tokens, ctx, errors, globals, allocations, body, 1)
        be_expect(tokens, ctx, errors, 41)
        return result
    }
    if kind == 309 or kind == 318 {
        var name = get(ctx, 0)
        be_next(ctx)
        if be_kind(tokens, ctx) != 40 { be_error_at(tokens, errors, 200, name); be_meta(ctx, 1, 0); return buffer("0") }
        return be_call(source, tokens, ctx, errors, globals, allocations, body, name)
    }
    if kind == 1 {
        var name = get(ctx, 0)
        be_next(ctx)
        if be_kind(tokens, ctx) == 40 { return be_call(source, tokens, ctx, errors, globals, allocations, body, name) }
        var local = be_find(source, tokens, ctx, get(ctx, 7), name)
        var aggregate = be_record_find(source, tokens, ctx, name)
        if local < 0 and aggregate >= 0 and be_kind(tokens, ctx) == 46 {
            var info = be_enum_info(ctx, aggregate + 100)
            if info >= 0 {
                be_next(ctx)
                var variant_name = get(ctx, 0); be_expect(tokens, ctx, errors, 1)
                var variant = be_enum_variant(source, tokens, ctx, info, variant_name)
                if variant < 0 { be_error_at(tokens, errors, 215, variant_name); be_meta(ctx, 1, 0); return buffer("0") }
                return be_enum_call(source, tokens, ctx, errors, globals, allocations, body, aggregate, variant)
            }
        }
        if local < 0 { be_error(tokens, ctx, errors, 202); be_meta(ctx, 1, 0); return buffer("0") }
        if get(ctx, local + 2) == 6 { be_error_at(tokens, errors, 208, name); be_meta(ctx, 1, 0); return buffer("0") }
