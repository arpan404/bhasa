}
def be_is_field_assignment(tokens: ints, ctx: ints) -> bool {
    var index = get(ctx, 0)
    if bh_token_kind(tokens, index) != 1 { return false }
    index = index + 1
    var fields = 0
    while bh_token_kind(tokens, index) == 46 {
        index = index + 1
        if bh_token_kind(tokens, index) != 1 { return false }
        index = index + 1; fields = fields + 1
    }
    return fields > 0 and bh_token_kind(tokens, index) == 61
}
def be_field_assignment(source: buffer, tokens: ints, ctx: ints, errors: ints, globals: buffer, allocations: buffer, body: buffer, path: int) {
    if path < 0 { be_error(tokens, ctx, errors, 201); return }
    if get(ctx, path) < 0 { be_error(tokens, ctx, errors, 201); return }
    var reversed = ints()
    var root = path
    while get(ctx, root) >= 0 { push(reversed, get(ctx, root + 1)); root = get(ctx, root) }
    var local = be_find(source, tokens, ctx, get(ctx, 7), get(ctx, root + 1))
    if local < 0 { be_error(tokens, ctx, errors, 202); return }
    var fields = ints()
    var index = len(reversed)
    while index > 0 { index = index - 1; push(fields, get(reversed, index)) }
    be_expect(tokens, ctx, errors, 61)
    be_statement_expression(tokens, ctx, 0)
