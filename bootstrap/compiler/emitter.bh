    var value_type = get(ctx, 14)
    value = be_own(body, ctx, value_type, value, get(ctx, 15))
    # Recompute the target after RHS calls, then free only after acquiring RHS.
    var base = be_load(body, ctx, local)
    var ty = get(ctx, local + 2)
    var pointer = buffer()
    var i = 0
    while i < len(fields) and len(errors) == 0 {
        var token = get(fields, i)
        if ty < 100 { be_error_at(tokens, errors, 201, token); return }
        var field = be_record_field(source, tokens, ctx, ty, token)
        if field < 0 { be_error_at(tokens, errors, 202, token); return }
