def be_expression(source: buffer, tokens: ints, ctx: ints, errors: ints, globals: buffer, allocations: buffer, body: buffer, minimum: int) -> buffer {
    if get(ctx, 9) + get(ctx, 8) >= 128 { be_error(tokens, ctx, errors, 204); be_meta(ctx, 1, 0); return buffer("0") }
    set(ctx, 9, get(ctx, 9) + 1)
