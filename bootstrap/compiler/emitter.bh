    append(definitions, ")\n")
}
def be_contains(text: buffer, needle: buffer) -> bool {
    var i = 0
    while i + len(needle) <= len(text) {
        var j = 0
        while j < len(needle) and get(text, i + j) == get(needle, j) { j = j + 1 }
        if j == len(needle) { return true }
        i = i + 1
    }
    return false
}
def be_declarations(ctx: ints) -> buffer {
    var declarations = buffer()
    if get(ctx, 11) == 1 { append(declarations, "declare i32 @printf(ptr, ...)\n") }
    append(declarations, "declare void @llvm.trap() cold noreturn nounwind\ndeclare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)\ndeclare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)\ndeclare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)\ndeclare void @bhasa_rt_init(i32, ptr)\ndeclare ptr @bhasa_rt_buffer_new()\ndeclare ptr @bhasa_rt_buffer_from_str(ptr)\ndeclare ptr @bhasa_rt_buffer_clone(ptr)\ndeclare void @bhasa_rt_buffer_free(ptr)\ndeclare i64 @bhasa_rt_buffer_len(ptr)\ndeclare i64 @bhasa_rt_buffer_get(ptr, i64)\ndeclare void @bhasa_rt_buffer_set(ptr, i64, i64)\ndeclare void @bhasa_rt_buffer_push(ptr, i64)\ndeclare void @bhasa_rt_buffer_append(ptr, ptr)\ndeclare void @bhasa_rt_buffer_append_str(ptr, ptr)\ndeclare ptr @bhasa_rt_buffer_slice(ptr, i64, i64)\ndeclare i64 @bhasa_rt_buffer_same(ptr, ptr)\ndeclare i64 @bhasa_rt_buffer_same_str(ptr, ptr)\ndeclare ptr @bhasa_rt_to_buffer(i64)\ndeclare ptr @bhasa_rt_ints_new()\ndeclare ptr @bhasa_rt_ints_clone(ptr)\ndeclare void @bhasa_rt_ints_free(ptr)\ndeclare i64 @bhasa_rt_ints_len(ptr)\ndeclare i64 @bhasa_rt_ints_get(ptr, i64)\ndeclare void @bhasa_rt_ints_set(ptr, i64, i64)\ndeclare void @bhasa_rt_ints_push(ptr, i64)\ndeclare i64 @bhasa_rt_arg_count()\ndeclare ptr @bhasa_rt_arg(i64)\ndeclare i64 @bhasa_rt_read_file(ptr, ptr)\ndeclare i64 @bhasa_rt_read_file_str(ptr, ptr)\ndeclare i64 @bhasa_rt_write_file(ptr, ptr)\ndeclare i64 @bhasa_rt_write_file_str(ptr, ptr)\ndeclare i64 @bhasa_rt_read_stdin(ptr)\ndeclare i64 @bhasa_rt_write_stdout(ptr)\ndeclare i64 @bhasa_rt_write_stderr(ptr)\ndeclare void @bhasa_rt_print_buffer(ptr)\ndeclare void @bhasa_rt_args_push(ptr, ptr)\ndeclare void @bhasa_rt_args_push_str(ptr, ptr)\ndeclare i64 @bhasa_rt_process_run(ptr)\ndeclare ptr @bhasa_rt_spawn_i64(ptr, i64)\ndeclare i64 @bhasa_rt_join_i64(ptr)\ndeclare i64 @bhasa_rt_gpu_available()\ndeclare i64 @bhasa_rt_gpu_dispatch(ptr, ptr, ptr)\n")
