def be_invoke(source: buffer, tokens: ints, ctx: ints, errors: ints, globals: buffer, allocations: buffer, body: buffer, name_token: int, method: int, receiver: buffer, receiver_type: int, receiver_owns: int, receiver_path: int, receiver_depth: int) -> buffer {
