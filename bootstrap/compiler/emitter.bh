        if be_owned(ty) {
            var index = to_buffer(i)
            append(definitions, "  %field."); append(definitions, index); append(definitions, " = getelementptr "); append(definitions, record)
            append(definitions, ", ptr %record, i32 0, i32 "); append(definitions, index); append(definitions, "\n  %value."); append(definitions, index)
            append(definitions, " = load ptr, ptr %field."); append(definitions, index); append(definitions, "\n  call void @"); append(definitions, be_owned_symbol(ty, false))
            append(definitions, "(ptr %value."); append(definitions, index); append(definitions, ")\n")
        }
    }
    append(definitions, "  call void @free(ptr %record)\n  ret void\n}\n\n")
}
def be_record_helpers(ctx: ints, definitions: buffer, globals: buffer, target: buffer) {
    set(ctx, 22, 0)
    if get(ctx, 19) < 0 { return }
    # Helpers are required only for allocated, cloned or released record values.
    # Field access still requires the type declarations emitted below.
    var used = ints()
    var i = 0
    while i < len(ctx) { push(used, 0); i = i + 1 }
    var pending = ints()
    var node = get(ctx, 19)
    while node >= 0 {
        var name = be_number("@bhasa.record.", node + 100)
        append(name, ".")
        var method = be_number("@bhasa.method.", node + 100); append(method, ".")
        if be_contains(definitions, name) or (be_collection_kind(ctx, node + 100) != 0 and be_contains(definitions, method)) { set(used, node, 1); push(pending, node) }
        node = get(ctx, node)
    }
    i = 0
    while i < len(pending) {
        node = get(pending, i)
        var field = 0
        while field < get(ctx, node + 2) {
            var ty = get(ctx, node + 6 + field * 3)
            if ty >= 100 {
                var child = be_record_node(ty)
                if get(used, child) == 0 { set(used, child, 1); push(pending, child) }
            }
            field = field + 1
        }
        i = i + 1
    }
    node = get(ctx, 19)
    while node >= 0 {
        append(globals, be_number("%bhasa.record.", node + 100)); append(globals, " = type { ")
        i = 0
        while i < get(ctx, node + 2) {
            if i != 0 { append(globals, ", ") }
            append(globals, be_llvm_type(get(ctx, node + 6 + i * 3)))
            i = i + 1
        }
        append(globals, " }\n")
        node = get(ctx, node)
    }
    if len(pending) == 0 { return }
    set(ctx, 22, 1)
    var size_type = buffer("i64")
    if len(target) >= 7 {
        if same(slice(target, 0, 7), "wasm32-") { size_type = buffer("i32") }
    }
    append(definitions, "declare ptr @malloc("); append(definitions, size_type); append(definitions, ")\ndeclare void @free(ptr)\n\n")
    i = 0
    while i < len(pending) {
        be_record_helper(ctx, definitions, get(pending, i), size_type)
        i = i + 1
    }
}

# Enum info: next, aggregate-node, variant-head, variant-count.
# Variant: next, name-token, payload-count, first-field-index, tag.
# An enum shares the aggregate registry for ownership/depth checks, with a
# private i64 tag and disjoint payload slots. Only active slots are initialized.
def be_enum_info(ctx: ints, ty: int) -> int {
    var info = get(ctx, 27)
    while info >= 0 {
        if get(ctx, info + 1) + 100 == ty { return info }
        info = get(ctx, info)
    }
    return -1
}
def be_enum_variant(source: buffer, tokens: ints, ctx: ints, info: int, name: int) -> int {
    return be_find(source, tokens, ctx, get(ctx, info + 2), name)
}
def be_enum_fields(source: buffer, tokens: ints, ctx: ints, errors: ints, node: int, info: int) {
    set(ctx, 0, get(ctx, node + 3))
    be_expect(tokens, ctx, errors, 123)
    be_record_separators(tokens, ctx)
    set(ctx, node + 5, get(ctx, node + 1)); set(ctx, node + 6, 1)
    var field = 1
    while be_kind(tokens, ctx) != 125 and len(errors) == 0 {
        var name = get(ctx, 0)
        be_expect(tokens, ctx, errors, 1)
        if len(errors) != 0 { return }
        if be_enum_variant(source, tokens, ctx, info, name) >= 0 { be_error_at(tokens, errors, 212, name); return }
        var variant = len(ctx)
        push(ctx, get(ctx, info + 2)); push(ctx, name); push(ctx, 0); push(ctx, field); push(ctx, get(ctx, info + 3))
        set(ctx, info + 2, variant); set(ctx, info + 3, get(ctx, info + 3) + 1)
        if be_kind(tokens, ctx) == 40 {
            be_next(ctx)
            while be_kind(tokens, ctx) != 41 and len(errors) == 0 {
                var payload_name = get(ctx, 0)
                be_expect(tokens, ctx, errors, 1); be_expect(tokens, ctx, errors, 58)
                var ty = be_type(source, tokens, ctx, errors)
                if len(errors) != 0 { return }
                if ty == 0 or ty == 6 { be_error_at(tokens, errors, 201, payload_name); return }
                var earlier = get(ctx, variant + 3)
                while earlier < field {
                    if be_same_name(source, tokens, get(ctx, node + 5 + earlier * 3), payload_name) { be_error_at(tokens, errors, 212, payload_name); return }
                    earlier = earlier + 1
                }
                if field >= get(ctx, node + 2) { be_error_at(tokens, errors, 200, payload_name); return }
                set(ctx, node + 5 + field * 3, payload_name); set(ctx, node + 6 + field * 3, ty)
                field = field + 1; set(ctx, variant + 2, get(ctx, variant + 2) + 1)
                if be_kind(tokens, ctx) == 44 { be_next(ctx) } else {
                    if be_kind(tokens, ctx) != 41 { be_error(tokens, ctx, errors, 200) }
                }
            }
            be_expect(tokens, ctx, errors, 41)
        }
        var kind = be_kind(tokens, ctx)
        if kind != 125 and kind != 10 and kind != 59 and kind != 44 { be_error(tokens, ctx, errors, 200); return }
        be_record_separators(tokens, ctx)
    }
    be_expect(tokens, ctx, errors, 125)
    if get(ctx, info + 3) == 0 { be_error_at(tokens, errors, 215, get(ctx, node + 1)) }
    if field != get(ctx, node + 2) { be_error(tokens, ctx, errors, 200) }
}
def be_enum_call(source: buffer, tokens: ints, ctx: ints, errors: ints, globals: buffer, allocations: buffer, body: buffer, node: int, variant: int) -> buffer {
    be_expect(tokens, ctx, errors, 40)
    var args = ints(); var operands = buffer(); var depth = 2
    while be_kind(tokens, ctx) != 41 and len(errors) == 0 {
        var operand = be_expression(source, tokens, ctx, errors, globals, allocations, body, 1)
        var ty = get(ctx, 14)
        if depth < get(ctx, 23) + 1 { depth = get(ctx, 23) + 1 }
        if ty == 0 or ty == 6 { be_error(tokens, ctx, errors, 201) }
        # Acquire now, before a later argument can replace the borrowed source.
        operand = be_own(body, ctx, ty, operand, get(ctx, 15))
        push(args, ty); push(args, len(operands)); push(args, len(operand)); append(operands, operand)
        if be_kind(tokens, ctx) == 44 { be_next(ctx) } else {
            if be_kind(tokens, ctx) != 41 { be_error(tokens, ctx, errors, 200) }
        }
    }
    be_expect(tokens, ctx, errors, 41)
    if len(args) / 3 != get(ctx, variant + 2) { be_error(tokens, ctx, errors, 201) }
    var ty = node + 100
    var result = be_reg(ctx)
    var line = buffer(); append(line, result); append(line, " = call ptr @bhasa.record."); append(line, to_buffer(ty)); append(line, ".new()"); be_line(body, line)
    var pointer = be_field_pointer(body, ctx, ty, result, 0)
    line = buffer("store i64 "); append(line, to_buffer(get(ctx, variant + 4))); append(line, ", ptr "); append(line, pointer); be_line(body, line)
    var i = 0
    while i < len(args) / 3 and i < get(ctx, variant + 2) {
        var field = get(ctx, variant + 3) + i
        var payload_type = get(ctx, node + 6 + field * 3)
        if payload_type != get(args, i * 3) { be_error(tokens, ctx, errors, 201) }
        pointer = be_field_pointer(body, ctx, ty, result, field)
        line = buffer("store "); append(line, be_llvm_type(payload_type)); append(line, " "); append(line, slice(operands, get(args, i * 3 + 1), get(args, i * 3 + 2)))
        append(line, ", ptr "); append(line, pointer); be_line(body, line)
        i = i + 1
    }
    be_meta(ctx, ty, 1); set(ctx, 23, depth); set(ctx, 13, 0)
    return result
}
def be_match(source: buffer, tokens: ints, ctx: ints, errors: ints, globals: buffer, allocations: buffer, body: buffer) {
    var match_token = get(ctx, 0); be_next(ctx)
    be_statement_expression(tokens, ctx, 0)
    var value = be_expression(source, tokens, ctx, errors, globals, allocations, body, 1)
    var ty = get(ctx, 14); var info = be_enum_info(ctx, ty)
    if info < 0 { be_error_at(tokens, errors, 215, match_token); return }
    if get(ctx, 8) >= 128 { be_error_at(tokens, errors, 204, match_token); return }
    value = be_own(body, ctx, ty, value, get(ctx, 15))
    var saved = get(ctx, 7)
    # The keyword cannot collide with a source identifier. Keeping the snapshot
    # as an owned local lets ordinary return cleanup handle every branch.
    be_bind(source, tokens, ctx, errors, allocations, body, match_token, ty, value, 1)
    var snapshot = get(ctx, 7)
    var pointer = be_field_pointer(body, ctx, ty, value, 0)
    var tag = be_field_load(body, ctx, 1, pointer)
    var seen = ints(); var i = 0
    while i < get(ctx, info + 3) { push(seen, 0); i = i + 1 }
    var merge = be_label(ctx); var all_return = true
    be_newlines(tokens, ctx); be_expect(tokens, ctx, errors, 123); be_skip(tokens, ctx)
    while be_kind(tokens, ctx) != 125 and len(errors) == 0 {
        be_expect(tokens, ctx, errors, 317)
        var enum_name = get(ctx, 0); be_expect(tokens, ctx, errors, 1)
        if len(errors) != 0 { return }
        if be_record_find(source, tokens, ctx, enum_name) + 100 != ty { be_error_at(tokens, errors, 215, enum_name); return }
        be_expect(tokens, ctx, errors, 46)
        var variant_name = get(ctx, 0); be_expect(tokens, ctx, errors, 1)
        var variant = be_enum_variant(source, tokens, ctx, info, variant_name)
        if len(errors) != 0 { return }
        if variant < 0 { be_error_at(tokens, errors, 215, variant_name); return }
        var number = get(ctx, variant + 4)
        if get(seen, number) != 0 { be_error_at(tokens, errors, 216, variant_name); return }
        set(seen, number, 1)
        var bindings = ints()
        if be_kind(tokens, ctx) == 40 {
            be_next(ctx)
            while be_kind(tokens, ctx) != 41 and len(errors) == 0 {
                push(bindings, get(ctx, 0)); be_expect(tokens, ctx, errors, 1)
                if be_kind(tokens, ctx) == 44 { be_next(ctx) } else {
                    if be_kind(tokens, ctx) != 41 { be_error(tokens, ctx, errors, 200) }
                }
            }
            be_expect(tokens, ctx, errors, 41)
        }
        if len(bindings) != get(ctx, variant + 2) { be_error_at(tokens, errors, 215, variant_name); return }
        var arm = be_label(ctx); var next_arm = be_label(ctx); var condition = be_reg(ctx)
        var line = buffer(); append(line, condition); append(line, " = icmp eq i64 "); append(line, tag); append(line, ", "); append(line, to_buffer(number)); be_line(body, line)
        be_branch(body, ctx, condition, arm, next_arm); be_start(body, ctx, arm)
        set(ctx, 8, get(ctx, 8) + 1)
        i = 0
        while i < len(bindings) and len(errors) == 0 {
            var field = get(ctx, variant + 3) + i
            var payload_type = get(ctx, ty - 100 + 6 + field * 3)
            pointer = be_field_pointer(body, ctx, ty, value, field)
            var operand = be_field_load(body, ctx, payload_type, pointer)
            operand = be_own(body, ctx, payload_type, operand, 0)
            var owns = 0; if be_owned(payload_type) { owns = 1 }
            be_bind(source, tokens, ctx, errors, allocations, body, get(bindings, i), payload_type, operand, owns)
            i = i + 1
        }
        be_block(source, tokens, ctx, errors, globals, allocations, body, false)
        if get(ctx, 4) == 0 {
            all_return = false
            be_cleanup(body, ctx, snapshot)
            be_jump(body, ctx, merge)
        }
        set(ctx, 7, snapshot); set(ctx, 8, get(ctx, 8) - 1)
        be_start(body, ctx, next_arm)
        be_skip(tokens, ctx)
    }
    be_expect(tokens, ctx, errors, 125)
    i = 0
    while i < len(seen) {
        if get(seen, i) == 0 { be_error_at(tokens, errors, 216, match_token) }
        i = i + 1
    }
    be_line(body, buffer("call void @llvm.trap()")); be_line(body, buffer("unreachable")); set(ctx, 4, 1)
    be_start(body, ctx, merge)
    if all_return { be_line(body, buffer("unreachable")); set(ctx, 4, 1) } else { be_cleanup(body, ctx, saved) }
    set(ctx, 7, saved)
}
def be_enum_switch(definitions: buffer, ctx: ints, info: int) {
    append(definitions, "  switch i64 %tag, label %invalid [\n")
    var variant = get(ctx, info + 2)
    while variant >= 0 {
        append(definitions, "    i64 "); append(definitions, to_buffer(get(ctx, variant + 4))); append(definitions, ", label %variant."); append(definitions, to_buffer(get(ctx, variant + 4))); append(definitions, "\n")
        variant = get(ctx, variant)
    }
    append(definitions, "  ]\ninvalid:\n  call void @llvm.trap()\n  unreachable\n")
}
def be_enum_helpers(ctx: ints, definitions: buffer, node: int, info: int) {
    var record = be_number("%bhasa.record.", node + 100)
    var name = be_number("@bhasa.record.", node + 100)
    append(definitions, "define internal ptr "); append(definitions, name); append(definitions, ".clone(ptr %source) {\nentry:\n  %record = call ptr "); append(definitions, name); append(definitions, ".new()\n")
    append(definitions, "  %tag = load i64, ptr %source\n  store i64 %tag, ptr %record\n")
    be_enum_switch(definitions, ctx, info)
    var variant = get(ctx, info + 2)
    while variant >= 0 {
        append(definitions, "variant."); append(definitions, to_buffer(get(ctx, variant + 4))); append(definitions, ":\n")
        var i = get(ctx, variant + 3)
        while i < get(ctx, variant + 3) + get(ctx, variant + 2) {
            var ty = get(ctx, node + 6 + i * 3); var index = to_buffer(i); var llvm = be_llvm_type(ty)
            append(definitions, "  %source."); append(definitions, index); append(definitions, " = getelementptr "); append(definitions, record); append(definitions, ", ptr %source, i32 0, i32 "); append(definitions, index)
            append(definitions, "\n  %value."); append(definitions, index); append(definitions, " = load "); append(definitions, llvm); append(definitions, ", ptr %source."); append(definitions, index); append(definitions, "\n")
            var value = be_number("%value.", i)
            if be_owned(ty) {
                value = be_number("%copy.", i)
                append(definitions, "  "); append(definitions, value); append(definitions, " = call ptr @"); append(definitions, be_owned_symbol(ty, true)); append(definitions, "(ptr %value."); append(definitions, index); append(definitions, ")\n")
            }
            append(definitions, "  %target."); append(definitions, index); append(definitions, " = getelementptr "); append(definitions, record); append(definitions, ", ptr %record, i32 0, i32 "); append(definitions, index)
            append(definitions, "\n  store "); append(definitions, llvm); append(definitions, " "); append(definitions, value); append(definitions, ", ptr %target."); append(definitions, index); append(definitions, "\n")
            i = i + 1
        }
        append(definitions, "  ret ptr %record\n")
        variant = get(ctx, variant)
    }
    append(definitions, "}\n\ndefine internal void "); append(definitions, name); append(definitions, ".free(ptr %record) {\nentry:\n  %tag = load i64, ptr %record\n")
    be_enum_switch(definitions, ctx, info)
    variant = get(ctx, info + 2)
    while variant >= 0 {
        append(definitions, "variant."); append(definitions, to_buffer(get(ctx, variant + 4))); append(definitions, ":\n")
        var i = get(ctx, variant + 3) + get(ctx, variant + 2)
        while i > get(ctx, variant + 3) {
            i = i - 1
            var ty = get(ctx, node + 6 + i * 3)
            if be_owned(ty) {
                var index = to_buffer(i)
                append(definitions, "  %field."); append(definitions, index); append(definitions, " = getelementptr "); append(definitions, record); append(definitions, ", ptr %record, i32 0, i32 "); append(definitions, index)
                append(definitions, "\n  %value."); append(definitions, index); append(definitions, " = load ptr, ptr %field."); append(definitions, index)
                append(definitions, "\n  call void @"); append(definitions, be_owned_symbol(ty, false)); append(definitions, "(ptr %value."); append(definitions, index); append(definitions, ")\n")
            }
        }
        append(definitions, "  call void @free(ptr %record)\n  ret void\n")
        variant = get(ctx, variant)
    }
    append(definitions, "}\n\n")
}

def bh_compile(source: buffer, tokens: ints, errors: ints, target: buffer) -> buffer {
    if len(errors) != 0 { return buffer() }
    # Validate the table at the module boundary, including its final EOF row.
    # The normal scanner produces these invariants; reject malformed callers.
    if len(tokens) < 3 or len(tokens) % 3 != 0 {
        bh_triple(errors, 200, 0, 0); return buffer()
    }
    var token_index = 0
    var previous_end = 0
    while token_index < len(tokens) / 3 {
        var start = bh_token_start(tokens, token_index)
        var end = bh_token_end(tokens, token_index)
        var kind = bh_token_kind(tokens, token_index)
        if start < previous_end or end < start or end > len(source) {
            bh_triple(errors, 200, 0, 0); return buffer()
        }
        if kind == 314 and start != end {
            bh_triple(errors, 200, start, end); return buffer()
        }
        if kind == 0 and token_index + 1 != len(tokens) / 3 {
            bh_triple(errors, 200, start, end); return buffer()
        }
        previous_end = end
        token_index = token_index + 1
    }
    var last = len(tokens) / 3 - 1
    if bh_token_kind(tokens, last) != 0 or bh_token_start(tokens, last) != len(source) or bh_token_end(tokens, last) != len(source) {
        bh_triple(errors, 200, 0, 0); return buffer()
    }
    var ctx = ints()
    var i = 0
    while i < 31 { push(ctx, 0); i = i + 1 }
    set(ctx, 6, -1); set(ctx, 7, -1); set(ctx, 19, -1); set(ctx, 20, -1); set(ctx, 21, -1); set(ctx, 24, -1); set(ctx, 25, -1); set(ctx, 26, -1); set(ctx, 27, -1); set(ctx, 28, -1); set(ctx, 29, -1)
    if len(target) == 0 { be_error(tokens, ctx, errors, 200); return buffer() }
    i = 0
    while i < len(target) {
        var byte = get(target, i)
        if not bh_ident_byte(byte) and byte != 45 and byte != 46 { be_error(tokens, ctx, errors, 200); return buffer() }
        i = i + 1
    }
    be_records(source, tokens, ctx, errors)
    if len(errors) != 0 { return buffer() }
    be_signatures(source, tokens, ctx, errors)
    if len(errors) != 0 { return buffer() }
    var globals = buffer()
    var definitions = buffer()
    var node = get(ctx, 6)
    while node >= 0 and len(errors) == 0 {
        if get(ctx, node + 6) == 0 { be_function(source, tokens, ctx, errors, globals, definitions, node) }
        node = get(ctx, node)
    }
    if len(errors) != 0 { return buffer() }
    node = get(ctx, 24)
    while node >= 0 and len(errors) == 0 {
        be_function(source, tokens, ctx, errors, globals, definitions, node)
        node = get(ctx, node)
    }
    be_check_workers(tokens, ctx, errors)
    if len(errors) != 0 { return buffer() }
    be_task_wrappers(source, tokens, ctx, definitions)
    be_record_helpers(ctx, definitions, globals, target)
    var runtime = be_contains(definitions, buffer("@bhasa_rt_"))
    node = get(ctx, 6)
    while node >= 0 {
        if get(ctx, node + 6) == 1 {
            if get(ctx, 11) == 1 and same(bh_token_text(source, tokens, get(ctx, node + 1)), "printf") { be_error_at(tokens, errors, 210, get(ctx, node + 1)); return buffer() }
            if get(ctx, 22) == 1 and (same(bh_token_text(source, tokens, get(ctx, node + 1)), "malloc") or same(bh_token_text(source, tokens, get(ctx, node + 1)), "free")) { be_error_at(tokens, errors, 210, get(ctx, node + 1)); return buffer() }
            be_external(source, tokens, ctx, definitions, node)
        }
        if same(bh_token_text(source, tokens, get(ctx, node + 1)), "main") {
            if runtime { append(definitions, "define i32 @main(i32 %argc, ptr %argv) {\nentry:\n  call void @bhasa_rt_init(i32 %argc, ptr %argv)\n") } else { append(definitions, "define i32 @main() {\nentry:\n") }
            if get(ctx, node + 2) == 0 {
                append(definitions, "  call void @bhasa.fn.main()\n  ret i32 0\n}\n")
            } else {
                append(definitions, "  %result = call i64 @bhasa.fn.main()\n  %exit = trunc i64 %result to i32\n  ret i32 %exit\n}\n")
            }
        }
        node = get(ctx, node)
    }
    var module = buffer("; Bhasa-written LLVM compiler\n")
    if runtime { append(module, "; bhasa runtime: core\n") }
    if be_contains(definitions, buffer("@bhasa_rt_list_")) or be_contains(definitions, buffer("@bhasa_rt_map_")) { append(module, "; bhasa runtime: collections\n") }
    if be_contains(definitions, buffer("@bhasa_rt_utf8_")) { append(module, "; bhasa runtime: text\n") }
    if be_contains(definitions, buffer("@bhasa_rt_tcp_")) or be_contains(definitions, buffer("@bhasa_rt_monotonic_millis")) { append(module, "; bhasa runtime: net\n") }
    if be_contains(definitions, buffer("@bhasa_rt_spawn_")) or be_contains(definitions, buffer("@bhasa_rt_async_spawn_")) or be_contains(definitions, buffer("@bhasa_rt_await_")) or be_contains(definitions, buffer("@bhasa_rt_join_")) or be_contains(definitions, buffer("@bhasa_rt_task_alloc")) { append(module, "; bhasa runtime: threads\n") }
    if be_contains(definitions, buffer("@bhasa_rt_tls_")) { append(module, "; bhasa runtime: tls\n") }
    if be_contains(definitions, buffer("@bhasa_rt_gpu_")) { append(module, "; bhasa runtime: gpu\n") }
    append(module, "target triple = \""); append(module, target); append(module, "\"\n\n"); append(module, be_declarations(ctx))
    append(module, globals); append(module, "\n"); append(module, definitions)
    return module
}
