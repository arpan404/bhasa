    if kind == 45 and get(ctx, 14) == 10 { expected = 10 }
    if kind == 33 { expected = 2 }
    if get(ctx, 14) != expected { be_error(tokens, ctx, errors, 201) }
    var result = buffer()
    if kind == 45 {
