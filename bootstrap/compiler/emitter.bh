# Loop entries: previous loop, break label, continue label, locals retained on exits.
def be_loop_push(ctx: ints, exit_label: int, continue_label: int, retained: int) -> int {
    var node = len(ctx)
    push(ctx, get(ctx, 29)); push(ctx, exit_label); push(ctx, continue_label); push(ctx, retained)
    set(ctx, 29, node)
    return node
}
def be_loop_exit(tokens: ints, ctx: ints, errors: ints, body: buffer, is_break: bool) {
    var token = get(ctx, 0); be_next(ctx)
    var loop = get(ctx, 29)
