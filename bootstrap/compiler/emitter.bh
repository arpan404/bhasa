def be_unary(source: buffer, tokens: ints, ctx: ints, errors: ints, globals: buffer, allocations: buffer, body: buffer) -> buffer {
    var kind = be_kind(tokens, ctx)
    if kind != 45 and kind != 33 and kind != 126 { return be_postfix(source, tokens, ctx, errors, globals, allocations, body) }
    be_next(ctx)
    if kind == 45 and be_kind(tokens, ctx) == 2 { return be_literal(source, tokens, ctx, errors, true) }
    if get(ctx, 9) + get(ctx, 8) >= 128 { be_error(tokens, ctx, errors, 204); return buffer("0") }
    set(ctx, 9, get(ctx, 9) + 1)
