            var result = be_reg(ctx)
            var line = buffer(); append(line, result); append(line, " = phi i1 [ "); append(line, skipped)
            append(line, ", %b"); append(line, to_buffer(left_block)); append(line, " ], [ "); append(line, right)
            append(line, ", %b"); append(line, to_buffer(right_block)); append(line, " ]"); be_line(body, line)
            left = result; left_type = 2
        } else {
            var right = be_expression(source, tokens, ctx, errors, globals, allocations, body, be_precedence(operation) + 1)
