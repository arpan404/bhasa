{
  "name": "Bhasa",
  "scopeName": "source.bhasa",
  "patterns": [
    {
      "name": "comment.line.bhasa",
      "match": "(?:#|//).*$"
    },
    {
      "name": "string.quoted.double.bhasa",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.bhasa",
          "match": "\\\\[nrt\\\\\"]"
        },
        {
          "name": "invalid.illegal.escape.bhasa",
          "match": "\\\\."
        }
      ]
    },
    {
      "match": "\\b(def)\\s+([A-Za-z_][A-Za-z_0-9]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.bhasa"
        },
        "2": {
          "name": "entity.name.function.bhasa"
        }
      }
    },
    {
      "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z_0-9]*)",
      "captures": {
        "1": {
          "name": "storage.type.bhasa"
        },
        "2": {
          "name": "entity.name.type.bhasa"
        }
      }
    },
    {
      "match": "(?<==)[ \\t]*(try)\\b(?=[ \\t]+(?!and\\b|or\\b|not\\b|true\\b|false\\b)[A-Za-z_])",
      "captures": {
        "1": {
          "name": "keyword.control.bhasa"
        }
      }
    },
    {
      "name": "keyword.control.bhasa",
      "match": "\\b(?:extern|private|as|var|if|else|while|for|in|break|continue|return|import|struct|enum|match|case)\\b"
    },
    {
      "name": "keyword.operator.logical.bhasa",
      "match": "\\b(?:and|or|not)\\b"
    },
    {
      "name": "variable.language.bhasa",
      "match": "\\bself\\b"
    },
    {
      "name": "storage.type.bhasa",
      "match": "\\b(?:int|float|List|Map|bool|str|void|buffer|ints|task|tcp_listener|tcp_socket|tls_socket)\\b"
    },
    {
      "name": "constant.language.bhasa",
      "match": "\\b(?:true|false)\\b"
    },
    {
      "name": "constant.numeric.float.bhasa",
      "match": "\\b[0-9]+(?:\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\\b"
    },
    {
      "name": "constant.numeric.integer.bhasa",
      "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|[0-9]+)\\b"
    },
    {
      "name": "entity.name.function.call.bhasa",
      "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.bhasa",
      "match": "->|<<|>>|==|!=|<=|>=|&&|\\|\\||[+*/%=!<>&|^~-]"
    },
    {
      "name": "punctuation.bhasa",
      "match": "[{}()\\[\\],:;.]"
    }
  ]
}
