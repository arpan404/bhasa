{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}", "notIn": ["string", "comment"] },
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["(", ")"], ["\"", "\""]],
  "wordPattern": "[A-Za-z_][A-Za-z_0-9]*",
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{[^}\"#]*(?:(?:#|//).*)?$",
    "decreaseIndentPattern": "^\\s*\\}"
  }
}
