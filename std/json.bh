import "result.bh"

# A JSON document owns private bytes and a flat, bounded node table. Public
# accessors never mutate parser state and return owned copies. Number tokens
# retain their decimal spelling, including fractions and exponents.
# Node columns: kind, start, end, parent, key-start, key-end, subtree-end.
# Kinds: 1 null, 2 boolean, 3 number, 4 string, 5 array, 6 object.
struct JsonDoc {
    private source: buffer
    private nodes: ints
    private cursor: int
    private error: int

    def count(self) -> int { return len(self.nodes) / 7 }
    def bytes(self) -> buffer { return self.source }

    def kind(self, node: int) -> int {
        if node < 0 or node >= self.count() { return -1 }
        return get(self.nodes, node * 7)
    }

    def raw(self, node: int) -> buffer {
        if self.kind(node) < 0 { return buffer() }
        var start = get(self.nodes, node * 7 + 1)
        return slice(self.source, start, get(self.nodes, node * 7 + 2) - start)
    }

    def string(self, node: int) -> ResultText {
        if self.kind(node) != 4 { return ResultText.error(text("JSON value is not a string")) }
        var start = get(self.nodes, node * 7 + 1)
        var end = get(self.nodes, node * 7 + 2)
        return text_decode(json_unquote(self.source, start, end))
    }

    def integer(self, node: int) -> ResultInt {
        if self.kind(node) != 3 { return ResultInt.error(text("JSON value is not a number")) }
        var bytes = self.raw(node)
        var index = 0
        var negative = false
        if get(bytes, 0) == 45 { negative = true; index = 1 }
        var result = 0
        while index < len(bytes) {
            var digit = get(bytes, index) - 48
            if digit < 0 or digit > 9 { return ResultInt.error(text("JSON number is not an integer")) }
            var last = 7
            if negative { last = 8 }
            if result < -922337203685477580 or (result == -922337203685477580 and digit > last) {
                return ResultInt.error(text("JSON integer is outside int range"))
            }
            result = result * 10 - digit
            index = index + 1
        }
        if negative { return ResultInt.ok(result) }
        return ResultInt.ok(-result)
    }

    def find(self, node: int, key: Text) -> OptionInt {
        if self.kind(node) != 6 { return OptionInt.none() }
        var index = node + 1
        var end = get(self.nodes, node * 7 + 6)
        while index < end {
            var start = get(self.nodes, index * 7 + 4)
            var stop = get(self.nodes, index * 7 + 5)
            if same(json_unquote(self.source, start, stop), key.bytes()) { return OptionInt.some(index) }
            index = get(self.nodes, index * 7 + 6)
        }
        return OptionInt.none()
    }

    def item(self, node: int, position: int) -> OptionInt {
        if self.kind(node) != 5 or position < 0 { return OptionInt.none() }
        var index = node + 1
        var end = get(self.nodes, node * 7 + 6)
        var current = 0
        while index < end {
            if current == position { return OptionInt.some(index) }
            index = get(self.nodes, index * 7 + 6)
            current = current + 1
        }
        return OptionInt.none()
    }

    private def white(self) {
        while self.cursor < len(self.source) {
            var byte = get(self.source, self.cursor)
            if byte != 32 and byte != 9 and byte != 10 and byte != 13 { return }
            self.cursor = self.cursor + 1
        }
    }

    private def peek(self) -> int {
        if self.cursor >= len(self.source) { return -1 }
        return get(self.source, self.cursor)
    }

    private def hex(self) -> int {
        var result = 0
        var count = 0
        while count < 4 {
            var value = json_hex(self.peek())
            if value < 0 { self.error = 1; return -1 }
            result = result * 16 + value
            self.cursor = self.cursor + 1
            count = count + 1
        }
        return result
    }

    private def scan_string(self) {
        if self.peek() != 34 { self.error = 1; return }
        self.cursor = self.cursor + 1
        while self.cursor < len(self.source) {
            var byte = self.peek()
            self.cursor = self.cursor + 1
            if byte == 34 { return }
            if byte < 32 { self.error = 1; return }
            if byte == 92 {
                var escaped = self.peek()
                self.cursor = self.cursor + 1
                if escaped == 117 {
                    var scalar = self.hex()
                    if self.error != 0 { return }
                    if scalar >= 55296 and scalar <= 56319 {
                        if self.peek() != 92 { self.error = 1; return }
                        self.cursor = self.cursor + 1
                        if self.peek() != 117 { self.error = 1; return }
                        self.cursor = self.cursor + 1
                        var low = self.hex()
                        if low < 56320 or low > 57343 { self.error = 1; return }
                    } else {
                        if scalar >= 56320 and scalar <= 57343 { self.error = 1; return }
                    }
                } else {
                    if escaped != 34 and escaped != 92 and escaped != 47 and escaped != 98 and escaped != 102 and escaped != 110 and escaped != 114 and escaped != 116 {
                        self.error = 1; return
                    }
                }
            }
        }
        self.error = 1
    }

    private def digits(self) -> int {
        var start = self.cursor
        while self.peek() >= 48 and self.peek() <= 57 { self.cursor = self.cursor + 1 }
        return self.cursor - start
    }

    private def number(self) {
        if self.peek() == 45 { self.cursor = self.cursor + 1 }
        if self.peek() == 48 {
            self.cursor = self.cursor + 1
        } else {
            if self.peek() < 49 or self.peek() > 57 { self.error = 1; return }
            var count = self.digits()
            if count == 0 { self.error = 1; return }
        }
        if self.peek() == 46 {
            self.cursor = self.cursor + 1
            if self.digits() == 0 { self.error = 1; return }
        }
        if self.peek() == 101 or self.peek() == 69 {
            self.cursor = self.cursor + 1
            if self.peek() == 43 or self.peek() == 45 { self.cursor = self.cursor + 1 }
            if self.digits() == 0 { self.error = 1; return }
        }
    }

    private def literal(self, spelling: str, length: int) {
        if len(self.source) - self.cursor < length { self.error = 1; return }
        if !same(slice(self.source, self.cursor, length), spelling) { self.error = 1; return }
        self.cursor = self.cursor + length
    }

    private def value(self, parent: int, key_start: int, key_end: int, depth: int) -> int {
        self.white()
        if depth > 64 or self.count() >= 65536 { self.error = 2; return -1 }
        var start = self.cursor
        var kind = 0
        var byte = self.peek()
        if byte == 110 { kind = 1 }
        if byte == 116 or byte == 102 { kind = 2 }
        if byte == 45 or (byte >= 48 and byte <= 57) { kind = 3 }
        if byte == 34 { kind = 4 }
        if byte == 91 { kind = 5 }
        if byte == 123 { kind = 6 }
        if kind == 0 { self.error = 1; return -1 }
        var node = self.count()
        push(self.nodes, kind); push(self.nodes, start); push(self.nodes, 0)
        push(self.nodes, parent); push(self.nodes, key_start); push(self.nodes, key_end); push(self.nodes, 0)
        if kind == 1 { self.literal("null", 4) }
        if kind == 2 {
            if byte == 116 { self.literal("true", 4) } else { self.literal("false", 5) }
        }
        if kind == 3 { self.number() }
        if kind == 4 { self.scan_string() }
        if kind == 5 or kind == 6 {
            self.cursor = self.cursor + 1
            self.white()
            var close = 93
            if kind == 6 { close = 125 }
            if self.peek() == close {
                self.cursor = self.cursor + 1
            } else {
                var done = false
                while !done and self.error == 0 {
                    var property_start = -1
                    var property_end = -1
                    if kind == 6 {
                        property_start = self.cursor
                        self.scan_string()
                        property_end = self.cursor
                        self.white()
                        if self.peek() != 58 { self.error = 1; return -1 }
                        self.cursor = self.cursor + 1
                    }
                    var child = self.value(node, property_start, property_end, depth + 1)
                    if child < 0 or self.error != 0 { return -1 }
                    self.white()
                    if self.peek() == close {
                        self.cursor = self.cursor + 1
                        done = true
                    } else {
                        if self.peek() != 44 { self.error = 1; return -1 }
                        self.cursor = self.cursor + 1
                        self.white()
                    }
                }
            }
        }
        if self.error != 0 { return -1 }
        set(self.nodes, node * 7 + 2, self.cursor)
        var subtree_end = self.count()
        set(self.nodes, node * 7 + 6, subtree_end)
        return node
    }
}

enum JsonResult {
    ok(value: JsonDoc)
    error(message: Text)
}

def json_parse(source: buffer) -> JsonResult {
    if len(source) > 1048576 { return JsonResult.error(text("JSON exceeds 1 MiB")) }
    if !utf8_valid(source) { return JsonResult.error(text("invalid UTF-8 JSON")) }
    var document = JsonDoc(source, ints(), 0, 0)
    var root = document.value(-1, -1, -1, 0)
    document.white()
    if root < 0 or document.error != 0 or document.cursor != len(source) {
        return JsonResult.error(text("invalid or overly deep JSON"))
    }
    return JsonResult.ok(document)
}

private def json_hex(byte: int) -> int {
    if byte >= 48 and byte <= 57 { return byte - 48 }
    if byte >= 65 and byte <= 70 { return byte - 55 }
    if byte >= 97 and byte <= 102 { return byte - 87 }
    return -1
}

# Called only on a string token validated by JsonDoc.scan_string.
private def json_unquote(source: buffer, start: int, end: int) -> buffer {
    var result = buffer()
    var index = start + 1
    while index < end - 1 {
        var byte = get(source, index)
        index = index + 1
        if byte != 92 {
            push(result, byte)
        } else {
            var escaped = get(source, index)
            index = index + 1
            if escaped == 117 {
                var scalar = 0
                var count = 0
                while count < 4 { scalar = scalar * 16 + json_hex(get(source, index)); index = index + 1; count = count + 1 }
                if scalar >= 55296 and scalar <= 56319 {
                    index = index + 2
                    var low = 0
                    count = 0
                    while count < 4 { low = low * 16 + json_hex(get(source, index)); index = index + 1; count = count + 1 }
                    scalar = 65536 + (scalar - 55296) * 1024 + low - 56320
                }
                var status = utf8_append(result, scalar)
                if status != 0 { return buffer() }
            } else {
                if escaped == 98 { escaped = 8 }
                if escaped == 102 { escaped = 12 }
                if escaped == 110 { escaped = 10 }
                if escaped == 114 { escaped = 13 }
                if escaped == 116 { escaped = 9 }
                push(result, escaped)
            }
        }
    }
    return result
}

def json_quote(value: Text) -> ResultText {
    if !value.valid() { return ResultText.error(text("invalid UTF-8 text")) }
    var result = buffer("\"")
    var digits = buffer("0123456789abcdef")
    var bytes = value.bytes()
    var index = 0
    while index < len(bytes) {
        var byte = get(bytes, index)
        if byte == 34 or byte == 92 { push(result, 92); push(result, byte) } else {
            if byte < 32 {
                append(result, "\\u00")
                push(result, get(digits, byte / 16)); push(result, get(digits, byte % 16))
            } else { push(result, byte) }
        }
        index = index + 1
    }
    push(result, 34)
    return ResultText.ok(text_from_bytes(result))
}
